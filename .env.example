# Вход через Keycloak. Скопируйте в .env и заполните; .env в git не попадает.

# keycloak — вход обязателен (рабочий режим); disabled — без входа, все права, только для локальной разработки.
AUTH_MODE=keycloak

# Адрес realm: https://<keycloak>/realms/<realm>
KEYCLOAK_ISSUER=https://keycloak-sbx.k8s.aton.global/realms/appsoft
KEYCLOAK_CLIENT_ID=service-catalog
KEYCLOAK_CLIENT_SECRET=
# Клиентская роль, которая даёт право менять данные. Читать может любой вошедший в realm.
KEYCLOAK_ADMIN_ROLE=catalog-admin
# Корневой сертификат, которым подписан Keycloak. Корпоративный корень Security Administrator
# уже лежит в образе (папка certs/). Пусто — системные корни Python.
KEYCLOAK_CA_BUNDLE=/app/certs/aton-security-administrator-root-ca.crt

# Внешний адрес портала без слэша в конце. Из него строятся адреса /auth/callback и выхода.
# Тестовый стенд — http://tstmon201:8080.
PUBLIC_URL=http://tstmon201:8080

# Ключ подписи сессий: случайная строка от 32 символов, одинаковая для всех воркеров.
# Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=

# Срок сессии в часах. Роли из Keycloak перечитываются при следующем входе.
SESSION_LIFETIME_HOURS=8
# true — cookie только по HTTPS. Тестовый стенд открыт по HTTP, поэтому false:
# с true браузер не сохранит cookie и вход зациклится. При переходе на HTTPS поставить true.
SESSION_COOKIE_SECURE=false
